# Variáveis de ambiente — atualizar conforme o projeto evolui (docs/03, seção 3.2).
# Nunca versionar valores reais.

# ---- proxy (docs/12-proxy.md, seção 12.3) ----
SUPABASE_URL=https://osduhbgtwmdtffirypzo.supabase.co
# Conexão direta ao Postgres do Supabase (pooler). O proxy monta SQL parametrizado e transações.
DATABASE_URL=postgresql://postgres.osduhbgtwmdtffirypzo:[SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=
PROXY_ADMIN_KEY=
JWT_SIGNING_SECRET=
PORT=3001
ENV=dev                 # dev | homologacao | producao
# Opcionais: TOLERANCIA_TIMESTAMP_SEGUNDOS=60  RATE_LIMIT_JANELA_SEGUNDOS=60  RATE_LIMIT_MAXIMO=300

# ---- backend (Sistema 2) ----
# O backend lê as mesmas chaves ENV e PORT da seção do proxy, cada serviço no seu próprio .env.
# No .env do backend, use PORT=3000 (padrão quando ausente): é a porta de VITE_API_URL, e 3001 é a do proxy.
# Nível do log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula, sem barra final.
# Obrigatória em homologacao e producao; em producao não pode ser localhost nem valor de exemplo.
CORS_ORIGENS=http://localhost:5173
# Token de integrante emitido pelo proxy (service_id, escopos, expiração).
PROXY_URL=http://localhost:3001
PROXY_SERVICE_TOKEN=
PROXY_SERVICE_ID=sistema2-backend
# Resend (e-mail transacional: recuperação de senha, aviso de crédito)
RESEND_API_KEY=

# ---- frontend ----
VITE_API_URL=http://localhost:3000
