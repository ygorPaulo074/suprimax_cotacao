# Proxy (docs/12-proxy.md, seção 12.3). Copie para .env e preencha. Nunca versionar valores reais.
# Em dev, ENV=dev. No Render, ENV=producao e PORT NÃO é definido (o Render injeta; o padrão é 3001).
NODE_VERSION=20
ENV=dev                 # dev | homologacao | producao
PORT=3001

# Supabase: Project Settings -> API
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Transaction pooler (porta 6543). O proxy monta SQL parametrizado e transações.
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:[SENHA]@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Gerados por scripts/gerar-env.cjs (mín. 16 e 32 caracteres). Trocar o JWT_SIGNING_SECRET invalida
# todos os tokens já emitidos para o backend e para os Sistemas 1 e 3.
PROXY_ADMIN_KEY=
JWT_SIGNING_SECRET=

# Opcionais:
# TOLERANCIA_TIMESTAMP_SEGUNDOS=60
# RATE_LIMIT_JANELA_SEGUNDOS=60
# RATE_LIMIT_MAXIMO=300
