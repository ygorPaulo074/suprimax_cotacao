# Conexão exclusiva para migrations e seed. Use PostgreSQL local durante o desenvolvimento.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/suprimax_dev

# Usado apenas no seed; forneça um hash feito pelo mesmo mecanismo da autenticação do backend.
SEED_OPERATOR_USERNAME=admin
SEED_OPERATOR_EMAIL=admin@example.test
SEED_OPERATOR_PASSWORD_HASH=

# Os testes só aceitam localhost e um banco cujo nome termine em _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suprimax_test
