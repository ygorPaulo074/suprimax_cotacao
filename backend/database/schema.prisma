  rel_id_operador_vendedor           Operador         @relation("Rel_pedido_id_operador_vendedor", fields: [id_operador_vendedor], references: [id_operador])
  rel_id_endereco_entrega            EnderecoCliente? @relation("Rel_pedido_id_endereco_entrega", fields: [id_endereco_entrega], references: [id_endereco])
