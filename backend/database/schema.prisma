  rel_id_variacao       VariacaoProduto @relation("Rel_item_pedido_id_variacao", fields: [id_variacao], references: [id_variacao])
  rel_id_fardo          Fardo?          @relation("Rel_item_pedido_id_fardo", fields: [id_fardo], references: [id_fardo])

  @@index([id_pedido])
  @@index([id_variacao])
  @@index([id_fardo])
  @@map("item_pedido")
}

model RespostaOrcamento {
  id_resposta                                      Int                     @id @default(autoincrement()) @db.Integer
  id_orcamento                                     Int                     @db.Integer
  tipo_resposta                                    String                  @db.VarChar(10)
  status_resposta                                  String                  @default("PENDENTE") @db.VarChar(20)
  motivo_tratamento                                String?                 @db.VarChar(22)
  justificativa                                    String?                 @db.Text
  id_operador_vendedor                             Int                     @db.Integer
  data_resposta                                    DateTime                @default(now()) @db.Timestamp(6)
  data_processamento                               DateTime?               @db.Timestamp(6)
  id_operador_tratamento                           Int?                    @db.Integer
  data_tratamento                                  DateTime?               @db.Timestamp(6)
  valor_total_itens_aprovado                       Decimal?                @db.Decimal(12, 2)
  valor_total_imposto_aprovado                     Decimal?                @db.Decimal(12, 2)
  modalidade_frete_aceita                          String?                 @db.VarChar(3)
  valor_frete_aceito                               Decimal?                @db.Decimal(12, 2)
  valor_total_aceito                               Decimal?                @db.Decimal(12, 2)
  rel_id_orcamento                                 Orcamento               @relation("Rel_resposta_orcamento_id_orcamento", fields: [id_orcamento], references: [id_orcamento], onDelete: Cascade)
  rel_id_operador_vendedor                         Operador                @relation("Rel_resposta_orcamento_id_operador_vendedor", fields: [id_operador_vendedor], references: [id_operador])
  rel_id_operador_tratamento                       Operador?               @relation("Rel_resposta_orcamento_id_operador_tratamento", fields: [id_operador_tratamento], references: [id_operador])
  rel_item_resposta_orcamento_id_resposta_children ItemRespostaOrcamento[] @relation("Rel_item_resposta_orcamento_id_resposta")

  @@index([id_orcamento, status_resposta])
  @@index([id_operador_vendedor])
  @@index([id_operador_tratamento])
  @@map("resposta_orcamento")
}

model ItemRespostaOrcamento {
  id_item_resposta          Int               @id @default(autoincrement()) @db.Integer
  id_resposta               Int               @db.Integer
  id_item                   Int               @db.Integer
  quantidade_aprovada       Int               @db.Integer
  situacao                  String            @db.VarChar(12)
  id_faixa_preco_aceita     Int?              @db.Integer
  preco_unitario_aceito     Decimal?          @db.Decimal(12, 2)
  valor_imposto_aceito      Decimal?          @db.Decimal(12, 2)
  valor_total_item_aceito   Decimal?          @db.Decimal(12, 2)
  rel_id_resposta           RespostaOrcamento @relation("Rel_item_resposta_orcamento_id_resposta", fields: [id_resposta], references: [id_resposta], onDelete: Cascade)
  rel_id_item               ItemOrcamento     @relation("Rel_item_resposta_orcamento_id_item", fields: [id_item], references: [id_item], onDelete: Cascade)
  rel_id_faixa_preco_aceita FaixaPreco?       @relation("Rel_item_resposta_orcamento_id_faixa_preco_aceita", fields: [id_faixa_preco_aceita], references: [id_faixa_preco])

  @@unique([id_resposta, id_item], map: "item_resposta_por_resposta_unique")
  @@index([id_resposta])
  @@index([id_item])
  @@index([id_faixa_preco_aceita])
  @@map("item_resposta_orcamento")
}

model MovimentacaoEstoque {
  id_movimentacao   Int                @id @default(autoincrement()) @db.Integer
  id_variacao       Int                @db.Integer
  tipo              String             @db.VarChar(7)
  quantidade        Int                @db.Integer
  id_operador       Int?               @db.Integer
  id_orcamento      Int?               @db.Integer
  id_entrada        Int?               @db.Integer
  motivo            String?            @db.Text
  data_movimentacao DateTime           @default(now()) @db.Timestamp(6)
  rel_id_variacao   VariacaoProduto    @relation("Rel_movimentacao_estoque_id_variacao", fields: [id_variacao], references: [id_variacao])
  rel_id_operador   Operador?          @relation("Rel_movimentacao_estoque_id_operador", fields: [id_operador], references: [id_operador])
  rel_id_orcamento  Orcamento?         @relation("Rel_movimentacao_estoque_id_orcamento", fields: [id_orcamento], references: [id_orcamento], onDelete: SetNull)
  rel_id_entrada    EntradaMercadoria? @relation("Rel_movimentacao_estoque_id_entrada", fields: [id_entrada], references: [id_entrada])

  @@index([id_variacao, data_movimentacao])
  @@index([id_operador])
  @@index([id_orcamento])
  @@index([id_entrada])
  @@map("movimentacao_estoque")
}

// Tabelas operacionais do proxy, descritas em docs/12-proxy.md.
model IntegranteProxy {
  id           String    @id @db.Uuid
  nome_sistema String    @db.VarChar(60)
  chave_hash   String    @db.Char(64)
  escopos      String[]  @db.Text
  ativo        Boolean   @default(true)
  criado_em    DateTime  @default(now()) @db.Timestamptz(6)
  expira_em    DateTime? @db.Timestamptz(6)

  @@index([ativo])
  @@map("integrantes_proxy")
}

model FilaEscrita {
  id             String   @id @db.Uuid
  sistema_origem String   @db.VarChar(100)
  dominio        String   @db.VarChar(100)
  operacao       String   @db.VarChar(100)
  payload        Json     @db.JsonB
  status         String   @default("pendente") @db.VarChar(12)
  tentativas     Int      @default(0) @db.Integer
  criado_em      DateTime @default(now()) @db.Timestamptz(6)
  atualizado_em  DateTime @default(now()) @db.Timestamptz(6)
  erro_mensagem  String?  @db.Text

  @@index([status, criado_em])
  @@map("fila_escrita")
}

model LogAuditoria {
  id                          BigInt   @id @default(autoincrement()) @db.BigInt
  timestamp                   DateTime @default(now()) @db.Timestamptz(6)
  sistema_origem              String   @db.VarChar(100)
  operacao                    String   @db.VarChar(120)
  resultado_verificacao_risco String   @db.VarChar(20)
  status_execucao             String   @db.VarChar(10)
  duracao_ms                  Int      @db.Integer
  request_id                  String   @db.VarChar(100)
  resultado                   String   @db.VarChar(100)
  id_usuario                  String?  @db.Text
  ip_origem                   String?  @db.Inet

  @@index([timestamp])
  @@index([sistema_origem])
  @@map("log_auditoria")
}
