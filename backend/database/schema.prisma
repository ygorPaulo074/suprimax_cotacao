  rel_id_variacao                              VariacaoProduto       @relation("Rel_entrada_mercadoria_id_variacao", fields: [id_variacao], references: [id_variacao])
  rel_id_operador                              Operador              @relation("Rel_entrada_mercadoria_id_operador", fields: [id_operador], references: [id_operador])
  rel_id_operador_liberacao                    Operador?             @relation("Rel_entrada_mercadoria_id_operador_liberacao", fields: [id_operador_liberacao], references: [id_operador])
