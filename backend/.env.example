# Backend do Sistema 2. Copie para .env e preencha. Nunca versionar valores reais.
# No Render, PORT NÃO é definido (o Render injeta; o padrão é 3000) e ENV=producao.
NODE_VERSION=20
ENV=dev                 # dev | homologacao | producao
PORT=3000
# Nível do log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula, sem barra final.
# Obrigatória em homologacao e producao; em producao não pode ser localhost nem valor de exemplo.
CORS_ORIGENS=http://localhost:5173
# Sessão (UC13): minutos sem uso até expirar. Padrão: 30.
SESSAO_INATIVIDADE_MINUTOS=30
# Proxies reversos à frente do backend, para identificar o IP do cliente. Local: 0. No Render: 1.
TRUST_PROXY=0

# Acesso ao proxy (backend/comunicacao-backend-proxy.md). PROXY_SERVICE_ID é um UUID e precisa ser
# igual ao service_id do token. Os dois vêm de scripts/gerar-env.cjs (backend.env).
# Obrigatórias em homologacao e producao, onde não podem ficar com valor de exemplo (localhost,
# changeme...). Em dev, sem as três, o backend sobe e as rotas que dependem de dados respondem 503.
PROXY_URL=http://localhost:3001
PROXY_SERVICE_ID=
PROXY_SERVICE_TOKEN=

# Resend (e-mail transacional). O backend ainda não lê esta variável.
RESEND_API_KEY=
