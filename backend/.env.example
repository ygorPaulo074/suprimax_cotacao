# Backend do Sistema 2. Copie para .env e preencha. Nunca versionar valores reais.
# No Render, PORT NÃO é definido (o Render injeta; o padrão é 3000) e ENV=producao.
NODE_VERSION=20
ENV=dev                 # dev | homologacao | producao
PORT=3000
# Nível do log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula, sem barra final.
# Obrigatória em homologacao e producao; em producao não pode ser localhost nem valor de exemplo.
CORS_ORIGENS=http://localhost:5173
# Sessão (UC13): minutos sem uso até expirar. Padrão: 30.
SESSAO_INATIVIDADE_MINUTOS=30
# Sessões no banco (tabela sessao, pelo proxy): sobrevivem a deploy e reinício. Padrão: false
# (memória do processo). Ligue só depois de aplicar a migration 20261118000000_sessao (que também
# dá ao integrante do backend os escopos operacao:sessao.*) e de implantar o proxy com sessao.*.
SESSOES_NO_BANCO=false
# Proxies reversos à frente do backend, para identificar o IP do cliente. Local: 0. No Render: 1.
TRUST_PROXY=0

# Acesso ao proxy (backend/comunicacao-backend-proxy.md). PROXY_SERVICE_ID é um UUID e precisa ser
# igual ao service_id do token. Os dois vêm de scripts/gerar-env.cjs (backend.env).
# Obrigatórias em homologacao e producao, onde não podem ficar com valor de exemplo (localhost,
# changeme...). Em dev, sem as três, o backend sobe e as rotas que dependem de dados respondem 503.
PROXY_URL=http://localhost:3001
PROXY_SERVICE_ID=
PROXY_SERVICE_TOKEN=

# Jobs agendados (UC20, RF16, RN06). Duas formas de disparar: o agendador dentro do processo
# (JOBS_AGENDADOS_HABILITADOS=true) ou um cron externo chamando POST /jobs/executar com
# "Authorization: Bearer <JOBS_TOKEN>". Padrão do agendador: desligado, a cada 60 minutos (máx. 1440).
JOBS_AGENDADOS_HABILITADOS=false
JOBS_AGENDADOS_INTERVALO_MINUTOS=60
# Segredo do cron externo (SEGREDO: nunca versionar um valor real; mínimo de 16 caracteres, sem espaços;
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). Vazio = via por
# token desligada; só a sessão de GESTOR/ADMIN dispara os jobs. Em producao não pode ser valor de exemplo.
JOBS_TOKEN=

# Resend (e-mail de definição e de recuperação de senha, UC13 e UC25). Sem RESEND_API_KEY nada é
# enviado: só vai uma linha de log (dev/teste). Com ela, EMAIL_REMETENTE (remetente verificado no
# Resend) e FRONTEND_URL (base do link /redefinir-senha, sem barra final) passam a ser obrigatórias.
RESEND_API_KEY=
EMAIL_REMETENTE=
FRONTEND_URL=http://localhost:5173
# Dados da SupriMax para o cabeçalho e o rodapé do PDF de orçamento (docs/09-documento-de-orcamento-pdf.md).
# Não há tabela no banco para isso — é informação fixa da empresa, não um cadastro.
# Obrigatórias em homologacao e producao; em dev, sem elas, o PDF sai com um placeholder visível.
# Os valores abaixo são FICTÍCIOS (projeto acadêmico; o CNPJ é um número de teste). Troque pelos reais antes de emitir um orçamento de verdade.
EMPRESA_RAZAO_SOCIAL=SupriMax Suprimentos Ltda
EMPRESA_ENDERECO=Rua das Palmeiras, 1000, Centro, São Paulo/SP, CEP 01000-000
EMPRESA_TELEFONE=(11) 3000-0000
EMPRESA_CNPJ=11.222.333/0001-81
EMPRESA_INSCRICAO_ESTADUAL=123.456.789.110
EMPRESA_PIX=11222333000181
EMPRESA_DADOS_BANCARIOS=Banco 000 - Agência 0001 - Conta corrente 12345-6
